# =============================================================================
# Millennials Company Portfolio Website — Environment Configuration Example
# =============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit the actual '.env' file or production secrets to version control.

# -----------------------------------------------------------------------------
# Core Django Settings
# -----------------------------------------------------------------------------
# In production, generate a cryptographically strong secret key (50+ characters):
# e.g., python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-secure-secret-key-of-at-least-50-characters-in-production

# Set to False in production. NEVER run with DEBUG=True in production.
DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve:
ALLOWED_HOSTS=127.0.0.1,localhost,testserver,trinial.in,www.trinial.in,trinials.in,www.trinials.in

# Comma-separated list of trusted origins for CSRF POST requests (scheme + host):
CSRF_TRUSTED_ORIGINS=https://trinial.in,https://www.trinial.in,https://trinials.in,https://www.trinials.in

# -----------------------------------------------------------------------------
# HTTPS & Security Settings (Set to True in production under HTTPS)
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# -----------------------------------------------------------------------------
# Database Configuration (Optional / Environment-Driven)
# Defaults to local SQLite (db.sqlite3) if DB_ENGINE is left blank.
# -----------------------------------------------------------------------------
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=millennials_db
# DB_USER=millennials_user
# DB_PASSWORD=your-secure-database-password
# DB_HOST=localhost
# DB_PORT=5432

# -----------------------------------------------------------------------------
# Email Notification Configuration (Gmail / SMTP)
# If configured, new contact inquiries trigger an email notification.
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
GMAIL_EMAIL=dummy11248@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_HOST_USER=dummy11248@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Trinials <dummy11248@gmail.com>
CONTACT_NOTIFICATION_EMAIL=johnpaulalex85@gmail.com, trinial26@gmail.com, Jojogeorge.trinials@gmail.com, joejoseph1235@gmail.com

# -----------------------------------------------------------------------------
# Direct Contact Configuration (Navbar "Let's Talk", Footer & Contact Section)
# -----------------------------------------------------------------------------
CONTACT_EMAIL=trinial26@gmail.com
CONTACT_PHONE_NUMBER=+91 85908 21155
CONTACT_PHONE_NUMBER_SECONDARY=+91 94003 25570
CONTACT_WHATSAPP_URL=https://wa.me/918590821155

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
